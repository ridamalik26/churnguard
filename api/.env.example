# Groq API key used to generate retention emails and recommendations. Leave unset to use
# the deterministic fallback template instead of calling Groq.
GROQ_API_KEY=

# Port the Flask/gunicorn server binds to. Defaults to 5053 if not set.
PORT=5053

# Comma-separated list of origins allowed to call this API (CORS). Defaults to
# http://localhost:5025 (the local Next.js dev server) if not set.
ALLOWED_ORIGINS=http://localhost:5025

# Path to the SQLite database that stores generated retention recommendations. Defaults to
# data/retention.db under the project root if not set.
RETENTION_DB_PATH=data/retention.db
